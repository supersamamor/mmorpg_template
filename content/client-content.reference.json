{"format_version":6,"content_hash":"8145257204f06afb6d3aaafa451a4c81fdaaa24dda1f197989a81897596c6c8f","currency_name":"crowns","elements":["earth","fire","ghost","holy","neutral","poison","shadow","undead","water","wind"],"stats":["str","agi","vit","int","dex","luk","max_hp","max_sp","atk","matk","def","mdef","hit","flee","crit","aspd","move_speed","cast_time_mod","hp_regen","sp_regen","weight_limit"],"items":[{"id":"item.antidote","name":"Antidote","description":"Cures poison.","kind":"consumable","icon":"icon.item.antidote","ground":"model.prop.loot_bag"},{"id":"item.beetle_shell","name":"Beetle Shell","description":"A glossy, tough plate of chitin.","kind":"material","icon":"icon.item.beetle_shell","ground":"model.prop.loot_bag"},{"id":"item.blank_page","name":"Blank Page","description":"A page of pale parchment that drinks the ink out of your memory. Read it to take back every skill point you have spent. Free to use below level 10.","kind":"consumable","icon":"icon.item.blank_page","ground":"model.prop.loot_bag","confirm_use":true},{"id":"item.boar_tusk","name":"Boar Tusk","description":"A curved tusk from a thornback boar.","kind":"material","icon":"icon.item.boar_tusk","ground":"model.prop.loot_bag"},{"id":"item.bone_dirk","name":"Bone Dirk","description":"A short blade carved from beast bone. Every wanderer starts with one.","kind":"equip","icon":"icon.item.bone_dirk","ground":"model.prop.loot_bag","slots":["weapon"],"weapon_type":"dagger","visual":"model.equip.bone_dirk","refinable":true},{"id":"item.focus_tonic","name":"Focus Tonic","description":"A minty blue tonic that restores SP.","kind":"consumable","icon":"icon.item.focus_tonic","ground":"model.prop.loot_bag"},{"id":"item.gel_glob","name":"Gel Glob","description":"A wobbly blob of slime. Crafters pay a few coins for it.","kind":"material","icon":"icon.item.gel_glob","ground":"model.prop.loot_bag"},{"id":"item.gelcap_card","name":"Gelcap Card","description":"Socket into armour or a shield to gain extra max HP.","kind":"card","icon":"icon.item.gelcap_card","ground":"model.prop.loot_bag","slots":["body","shield"]},{"id":"item.healing_draught","name":"Healing Draught","description":"A bitter red tonic that restores HP.","kind":"consumable","icon":"icon.item.healing_draught","ground":"model.prop.loot_bag","use_sfx":"sfx.item.use.potion"},{"id":"item.iron_blade","name":"Iron Blade","description":"A plain, honest one-handed sword.","kind":"equip","icon":"icon.item.iron_blade","ground":"model.prop.loot_bag","slots":["weapon"],"weapon_type":"sword_1h","visual":"model.equip.iron_blade","equip_sfx":"sfx.item.equip.metal","card_slots":1,"refinable":true},{"id":"item.leather_cap","name":"Leather Cap","description":"Keeps the sun and the odd stray pebble off your head.","kind":"equip","icon":"icon.item.leather_cap","ground":"model.prop.loot_bag","slots":["head_top"],"visual":"model.equip.leather_cap"},{"id":"item.mossy_fiber","name":"Mossy Fiber","description":"Springy green fibers pulled from a mossling.","kind":"material","icon":"icon.item.mossy_fiber","ground":"model.prop.loot_bag"},{"id":"item.oak_staff","name":"Oak Staff","description":"A knotted staff that focuses magic.","kind":"equip","icon":"icon.item.oak_staff","ground":"model.prop.loot_bag","slots":["weapon"],"weapon_type":"staff","visual":"model.equip.oak_staff","card_slots":1,"refinable":true},{"id":"item.padded_vest","name":"Padded Vest","description":"Quilted cloth armour that turns aside glancing blows.","kind":"equip","icon":"icon.item.padded_vest","ground":"model.prop.loot_bag","slots":["body"],"visual":"model.equip.padded_vest","equip_sfx":"sfx.item.equip.cloth","card_slots":1,"refinable":true},{"id":"item.realign_tonic","name":"Realign Tonic","description":"A clear, faintly humming tonic. Drink it to take back every stat point you have spent. Free to use below level 10.","kind":"consumable","icon":"icon.item.realign_tonic","ground":"model.prop.loot_bag","use_sfx":"sfx.item.use.potion","confirm_use":true},{"id":"item.swift_elixir","name":"Swift Elixir","description":"Grants the Swift status for a minute.","kind":"consumable","icon":"icon.item.swift_elixir","ground":"model.prop.loot_bag"},{"id":"item.temper_shard","name":"Temper Shard","description":"A splinter of hard, glassy stone. Worked into a blade or a buckler, it makes the gear a little better, if the work takes.","kind":"material","icon":"icon.item.temper_shard","ground":"model.prop.loot_bag"},{"id":"item.warden_token","name":"Warden Token","description":"Proof that you passed the Warden\u0027s trial. Cannot be sold.","kind":"quest","icon":"icon.item.warden_token","ground":"model.prop.loot_bag"},{"id":"item.wasp_stinger","name":"Wasp Stinger","description":"Still faintly venomous. Handle with care.","kind":"material","icon":"icon.item.wasp_stinger","ground":"model.prop.loot_bag"},{"id":"item.wooden_buckler","name":"Wooden Buckler","description":"A small round shield.","kind":"equip","icon":"icon.item.wooden_buckler","ground":"model.prop.loot_bag","slots":["shield"],"visual":"model.equip.wooden_buckler","refinable":true}],"skills":[{"id":"skill.call_seedling","name":"Call Seedling","description":"Summon two helper seedlings that fight for a short time.","max_level":3,"passive":false,"range":3,"ground":true,"friendly":false,"cast_time_ms":2500,"animation":"cast","icon":"icon.skill.call_seedling","vfx":"vfx.skill.summon","sfx":"sfx.skill.summon"},{"id":"skill.cleanse","name":"Cleanse","description":"Wash away poison and stuns from an ally.","max_level":1,"passive":false,"range":5,"ground":false,"friendly":true,"cast_time_ms":1000,"animation":"cast","icon":"icon.skill.cleanse","vfx":"vfx.skill.heal","sfx":"sfx.skill.heal"},{"id":"skill.ember_bolt","name":"Ember Bolt","description":"Hurl a bolt of flame at a distant enemy.","max_level":10,"passive":false,"range":7,"ground":false,"friendly":false,"animation":"cast","icon":"icon.skill.ember_bolt","vfx":"vfx.skill.ember_bolt","sfx":"sfx.skill.fire"},{"id":"skill.iron_guard","name":"Iron Guard","description":"Harden your stance, raising DEF for a while.","max_level":3,"passive":false,"range":0,"ground":false,"friendly":true,"cast_time_ms":0,"animation":"cast","icon":"icon.skill.iron_guard","vfx":"vfx.skill.buff","sfx":"sfx.skill.buff"},{"id":"skill.mana_font","name":"Mana Font","description":"Open a well of mana on a cell; allies standing in it regain SP.","max_level":5,"passive":false,"range":5,"ground":true,"friendly":true,"area_shape":"square","area_radius":2,"cast_time_ms":2000,"animation":"cast","icon":"icon.skill.mana_font","vfx":"vfx.skill.mana_font","sfx":"sfx.skill.buff"},{"id":"skill.return_home","name":"Return Home","description":"Warp back to your save point.","max_level":1,"passive":false,"range":0,"ground":false,"friendly":true,"cast_time_ms":3000,"animation":"cast","icon":"icon.skill.return_home","vfx":"vfx.skill.warp","sfx":"sfx.skill.warp"},{"id":"skill.second_wind","name":"Second Wind","description":"Catch your breath and recover a little HP.","max_level":5,"passive":false,"range":0,"ground":false,"friendly":true,"cast_time_ms":0,"animation":"sit","icon":"icon.skill.second_wind","vfx":"vfx.skill.heal","sfx":"sfx.skill.heal"},{"id":"skill.shockwave","name":"Shockwave","description":"Slam the ground, hurling nearby enemies back and sometimes stunning them.","max_level":5,"passive":false,"range":0,"ground":false,"friendly":false,"area_shape":"square","area_radius":2,"cast_time_ms":500,"animation":"attack","icon":"icon.skill.shockwave","vfx":"vfx.skill.shockwave","sfx":"sfx.skill.slam"},{"id":"skill.tough_body","name":"Tough Body","description":"Permanently raises max HP and HP regeneration.","max_level":5,"passive":true,"range":0,"ground":false,"friendly":false,"cast_time_ms":0,"icon":"icon.skill.tough_body"},{"id":"skill.twin_strike","name":"Twin Strike","description":"Two quick cuts in one motion.","max_level":5,"passive":false,"range":1,"ground":false,"friendly":false,"cast_time_ms":0,"animation":"attack","icon":"icon.skill.twin_strike","vfx":"vfx.skill.slash","sfx":"sfx.skill.slash"},{"id":"skill.venom_sting","name":"Venom Sting","description":"Monster skill. A jab that may poison the target.","max_level":1,"passive":false,"range":1,"ground":false,"friendly":false,"cast_time_ms":300,"animation":"attack","vfx":"vfx.skill.sting","sfx":"sfx.skill.slash"}],"jobs":[{"id":"job.spellbinder","name":"Spellbinder","description":"A scholar of the old tongues who shapes flame and mana from a safe distance.","parent":"job.wanderer","weapon_types":["unarmed","dagger","staff"],"model":"model.char.spellbinder","icon":"icon.job.spellbinder","skills":[{"skill":"skill.ember_bolt","max_level":10},{"skill":"skill.mana_font","max_level":5,"requires":[{"skill":"skill.ember_bolt","level":2}]},{"skill":"skill.cleanse","max_level":1},{"skill":"skill.call_seedling","max_level":3}]},{"id":"job.wanderer","name":"Wanderer","description":"A newcomer to the Lumen Vale. Can learn a little of everything, master of nothing.","weapon_types":["unarmed","dagger"],"model":"model.char.wanderer","icon":"icon.job.wanderer","skills":[{"skill":"skill.second_wind","max_level":5},{"skill":"skill.return_home","max_level":1}]},{"id":"job.warden","name":"Warden","description":"A frontline guardian who protects the vale with blade and buckler.","parent":"job.wanderer","weapon_types":["unarmed","dagger","sword_1h","sword_2h","axe","mace"],"model":"model.char.warden","icon":"icon.job.warden","skills":[{"skill":"skill.twin_strike","max_level":5},{"skill":"skill.shockwave","max_level":5,"requires":[{"skill":"skill.twin_strike","level":3}]},{"skill":"skill.iron_guard","max_level":3},{"skill":"skill.tough_body","max_level":5}]}],"statuses":[{"id":"status.iron_skin","name":"Iron Skin","description":"Skin hardened like metal, raising DEF and slowing movement slightly.","debuff":false,"icon":"icon.status.iron_skin","vfx":"vfx.status.iron_skin"},{"id":"status.poison","name":"Poison","description":"Loses HP every second and has reduced DEF.","debuff":true,"icon":"icon.status.poison","vfx":"vfx.status.poison"},{"id":"status.stun","name":"Stun","description":"Dazed and unable to act.","debuff":true,"icon":"icon.status.stun","vfx":"vfx.status.stun"},{"id":"status.swift","name":"Swift","description":"Lightfooted; move and attack faster.","debuff":false,"icon":"icon.status.swift","vfx":"vfx.status.swift"}],"monsters":[{"id":"monster.gel_slime","name":"Gel Slime","model":"model.monster.gel_slime","sounds":{"hit":"sfx.monster.hit.slime","die":"sfx.monster.die.slime"}},{"id":"monster.mossling","name":"Mossling","model":"model.monster.mossling","sounds":{"die":"sfx.monster.die.generic"}},{"id":"monster.rock_beetle","name":"Rock Beetle","model":"model.monster.rock_beetle","sounds":{"aggro":"sfx.monster.aggro.generic","hit":"sfx.monster.hit.generic"}},{"id":"monster.sting_wasp","name":"Sting Wasp","model":"model.monster.sting_wasp","sounds":{"aggro":"sfx.monster.aggro.wasp","hit":"sfx.monster.hit.generic","die":"sfx.monster.die.generic"}},{"id":"monster.thornback_boar","name":"Thornback Boar","model":"model.monster.thornback_boar","sounds":{"aggro":"sfx.monster.aggro.generic","die":"sfx.monster.die.generic"}}],"npcs":[{"id":"npc.guide","name":"Odalys","title":"Vale Guide","model":"model.npc.guide","portrait":"portrait.npc.guide"},{"id":"npc.smith","name":"Tamsin","title":"Vale Smith","model":"model.npc.trainer","portrait":"portrait.npc.trainer"},{"id":"npc.trainer","name":"Captain Brannoc","title":"Warden Trainer","model":"model.npc.trainer","portrait":"portrait.npc.trainer"}],"quests":[{"id":"quest.first_hunt","name":"First Hunt","description":"Thin out the gel slimes in the meadow, then report back to Odalys.","giver":"npc.guide","steps":["Defeat 5 Gel Slimes, gather 3 Gel Globs and bring them to Odalys."]},{"id":"quest.gear_up","name":"Gear Up","description":"Learn the basics of equipment, potions and exploring the meadow.","giver":"npc.guide","steps":["Equip a Leather Cap.","Drink a Healing Draught."