[sub_resource type="BoxShape3D" id="ground_shape"]
size = Vector3(48, 1, 32)

[sub_resource type="Shader" id="checker"]
code = "shader_type spatial;
#include \"../render/toon_light.gdshaderinc\"
uniform vec3 a : source_color = vec3(0.5, 0.69, 0.36);
uniform vec3 b : source_color = vec3(0.47, 0.65, 0.34);
varying vec3 world;
void vertex() {
	world = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}
void fragment() {
	ALBEDO = mod(floor(world.x) + floor(world.z), 2.0) < 0.5 ? a : b;
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
}
"

