[gd_scene format=3]

[sub_resource type="Shader" id="sky_shader"]
code = "// A soft sky gradient (ADR-003 point 6, T-222). The game camera looks down at 50 degrees, so mostly the lower half shows, past the map's edge:
// pale near the horizon and a little deeper below, the same pale as the haze, so the play area stands out against it.
shader_type sky;
uniform vec3 zenith : source_color = vec3(0.56, 0.82, 0.95);
uniform vec3 horizon : source_color = vec3(0.91, 0.96, 1.0);
uniform vec3 below : source_color = vec3(0.70, 0.85, 0.93);
void sky() {
	float y = EYEDIR.y;
	COLOR = y >= 0.0 ? mix(horizon, zenith, pow(y, 0.8)) : mix(horizon, below, pow(-y, 0.7));
}
"

[sub_resource type="ShaderMaterial" id="sky_material"]
shader = SubResource("sky_shader")

[sub_resource type="Sky" id="sky"]
sky_material = SubResource("sky_material")
radiance_size = 0

