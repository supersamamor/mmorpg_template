<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The prebuilt 4.7.2 Android template only accepts net9.0 (docs/MOBILE_BUILD.md §4). -->
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Game.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BundleFile>$(MSBuildProjectDirectory)/bundle/client-content.json</BundleFile>
    <RepoRoot>$(MSBuildProjectDirectory)/..</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- netstandard2.1 is the build the client loads (ADR-001). No reflection over it: iOS is NativeAOT and trimmed. -->
    <ProjectReference Include="../src/Game.Shared/Game.Shared.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
    <!-- The server's own JSON mapping: it depends only on Game.Shared and System.Text.Json (ARCHITECTURE §10). -->
    <Compile Include="../src/Game.Server/Net/ProtocolJson.cs" Link="Linked/ProtocolJson.cs" />
    <!-- The minimap picture's asset key (T-812): validate and the HUD name the same key. -->
    <Compile Include="../src/Game.Content/Maps/MinimapKeys.cs" Link="Linked/MinimapKeys.cs" />
  </ItemGroup>
  <!-- The map authoring plugin and its exporter (T-208) are editor tools: no export configuration compiles them, so none of it reaches a phone. Debug is what the editor and the headless export run. -->
  <ItemGroup Condition=" '$(Configuration)' == 'Debug' ">
    <Compile Include="../src/Game.Content/Maps/TscnFile.cs" Link="Linked/TscnFile.cs" />
    <Compile Include="../src/Game.Content/Maps/MapSceneHash.cs" Link="Linked/MapSceneHash.cs" />
  </ItemGroup>
  <ItemGroup Condition=" '$(Configuration)' != 'Debug' ">
    <Compile Remove="addons/map_authoring/**" />
  </ItemGroup>
  <ItemGroup>
    <BundleInput Include="$(RepoRoot)/content/**/*" />
  </ItemGroup>
  <!--
    Android APK size (T-216, ARCHITECTURE §9). The self-contained publish brings the Mono runtime's static archives (*.a, 58 MB of 178 MB uncompressed:
    libmonosgen-2.0.a alone is 44 MB). Android loads only the *.so files from lib/, and nothing here links statically (only NativeAOT, i.e. iOS, does),
    so the archives are dead weight. The XML documentation of Game.Shared is not read at runtime either. The *.so files, the framework assemblies and the
    one architecture (arm64-v8a, export_presets.cfg) stay: trimming them is only safe to judge on a device (ADR-002 row 112).
  -->
  <Target Name="StripUnusedAndroidFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition=" '$(GodotTargetPlatform)' == 'android' ">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition=" '%(Extension)' == '.a' Or '%(Filename)%(Extension)' == 'Game.Shared.xml' " />
    </ItemGroup>
  </Target>
  <!-- Packs the display bundle into the project (generated, gitignored; ARCHITECTURE §5.4). Set SkipClientBundle=true to keep the file as it is. -->
  <Target Name="PackClientBundle" BeforeTargets="PrepareForBuild" Condition=" '$(SkipClientBundle)' != 'true' "
          Inputs="@(BundleInput)" Outputs="$(BundleFile)">
    <Exec Command="dotnet run --project &quot;$(RepoRoot)/src/Game.Tools&quot; --no-launch-profile -- export-client &quot;$(BundleFile)&quot;" WorkingDirectory="$(RepoRoot)" />
  </Target>
</Project>
