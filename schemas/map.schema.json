{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapDef",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^map\\.[a-z0-9_]+$",
      "description": "Map id, e.g. map.starter_town."
    },
    "name": {
      "type": "string",
      "description": "Display name."
    },
    "scene_asset_key": {
      "type": "string",
      "pattern": "^scene\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "Godot visual scene (scene.*), e.g. scene.map.starter_town."
    },
    "music_asset_key": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^music\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "Background music (music.*)."
    },
    "grid_file": {
      "type": "string",
      "description": "File name of the logic grid in content/maps/, e.g. starter_town.grid.json. A content file name, not an asset path."
    }
  },
  "additionalProperties": false,
  "description": "Map metadata (ARCHITECTURE §5.3). The logic grid (cells, spawns, warps, NPCs, zones) is a separate generated file named by GridFile; it is not a definition.",
  "required": [
    "id",
    "name",
    "scene_asset_key",
    "grid_file"
  ]
}
